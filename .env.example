# Documentation only: copy into an ignored local environment file or Vercel settings.
# No actual credentials or project-specific values belong in this example.

# Public API configuration. Prefer a modern publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only; choose one public key configuration.
# SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix a secret/service-role key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy compatibility only; choose one server key configuration.
# SUPABASE_SERVICE_ROLE_KEY=

# Primary Vercel Cron /api/health; random server secret of at least 16 characters.
CRON_SECRET=
# Compatibility override: leave unset or identical to CRON_SECRET on Vercel.
# CMS_HEALTH_SECRET=
# Neither value belongs in public repository variables.

# LOCAL DEVELOPMENT ONLY. Do not set on Vercel or use for cloud authentication tests.
# CMS_LOCAL_PREVIEW=1
# PREVIEW_PORT=4173

# Contact form configuration; server-only credentials.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# GitHub health workflow uses repository variables, not this file:
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, CMS_HEALTH_ENABLED=true
# Never supply SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY to that workflow.
